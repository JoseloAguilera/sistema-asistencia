Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
# No acceso web a código interno, herramientas, pruebas, archivos privados o dumps.
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(server|vendor|includes|objs|bin|database|tests|deployment|dist)(/|$) - [F,L,NC]
RewriteRule \.(sql|log|zip|bak|old|ini|env|lock|json|md|py|sh)$ - [F,L,NC]
</IfModule>
<FilesMatch "(?i)(^composer\.|private|config\.local|\.sql$|\.log$|\.bak$|\.env(?:\..*)?$)">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "same-origin"
</IfModule>
# Activar HTTPS con el panel del hosting antes de aceptar usuarios reales.
