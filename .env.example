# Copy to .env beside index.php; configure separately for local and Hostinger.
# Placeholders only: replace these locally, never commit real credentials.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=replace_database_name
DB_USER=replace_database_user
DB_PASS='replace_database_password'
# Optional Unix socket; leave empty to use DB_HOST/DB_PORT.
DB_SOCKET=
# Single quotes preserve literal #, $, spaces and double quotes in passwords.
# Optional absolute path to the existing private PHP configuration:
# APP_CONFIG=/private/path/asistencia-private.php
